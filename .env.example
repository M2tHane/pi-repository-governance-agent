GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_ALLOWED_REPOSITORIES=owner/repository
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/pi_governance
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=replace-me
PORT=3000
WEBHOOK_MAX_BYTES=1048576
QUEUE_CAPACITY=20
AGENT_TIMEOUT_MS=300000
GITHUB_CLIENT_ID=Iv1.example
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/auth/github/callback
SESSION_SECRET=replace-with-at-least-32-random-characters

# 可选：按本机已有代理填写，Node 24 原生支持；不要关闭 TLS 校验。
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
