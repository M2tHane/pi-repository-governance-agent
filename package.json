{
  "name": "pi-repository-governance-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --watch dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify-agent-note-tree": "node scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "node scripts/verify-agent-note-format.ts",
    "check:docs": "npm run verify-agent-note-tree && npm run verify-agent-note-format"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
