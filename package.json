{
  "name": "pi-repository-governance-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --watch dist/src/main.js",
    "build": "tsc -p tsconfig.json && node scripts/build-admin.mjs",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "migrate": "npm run build && node --env-file-if-exists=.env dist/src/migrate.js",
    "test": "npm run build && node --test dist/test/*/*.test.js",
    "test:db": "npm run build && node --env-file-if-exists=.env --test dist/test/*/database-*.test.js",
    "verify-agent-note-tree": "node scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "node scripts/verify-agent-note-format.ts",
    "check:docs": "npm run verify-agent-note-tree && npm run verify-agent-note-format && node scripts/check-markdown-links.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "pg": "8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "entities": "7.0.0",
    "esbuild": "^0.25.12",
    "github-slugger": "2.0.0",
    "marked": "18.0.5",
    "typescript": "7.0.2"
  }
}
