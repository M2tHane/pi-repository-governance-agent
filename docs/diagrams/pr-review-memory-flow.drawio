        <mxCell id="m-heading" value="&lt;b&gt;03 · 提取并确认规则&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFBEB;strokeColor=none;fontSize=21;align=left;fontColor=#D97706;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1025" y="125" width="410" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r-event" value="用户创建 / 更新 / 重新打开 PR&lt;br&gt;opened · synchronize · reopened · ready_for_review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#DBEAFE;strokeColor=#93C5FD;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="175" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p-event" value="&lt;b&gt;人类回复 App 已绑定的行内意见&lt;/b&gt;&lt;br&gt;同一 PR、同一线程允许多名用户" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#CCFBF1;strokeColor=#5EEAD4;" vertex="1" parent="1">
          <mxGeometry x="550" y="175" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m-event" value="&lt;b&gt;PR 已合并&lt;/b&gt;&lt;br&gt;closed 且 merged = true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FEF3C7;strokeColor=#FCD34D;" vertex="1" parent="1">
          <mxGeometry x="1030" y="175" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="&lt;b&gt;GitHub App → Webhook 验签 → 确定性路由与去重 → PostgreSQL Job → 单 Worker&lt;/b&gt;&lt;br&gt;检查事件类型、仓库授权与状态；普通 issue_comment 不进入实时 Reply Handler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#172B4D;strokeColor=#172B4D;fontColor=#FFFFFF;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="1380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="event-r" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#94A3B8;fontFamily=PingFang SC;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="r-event" target="ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="event-p" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#94A3B8;fontFamily=PingFang SC;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p-event" target="ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="event-m" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#94A3B8;fontFamily=PingFang SC;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="m-event" target="ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;PR_REVIEW：固定代码快照&lt;/b&gt;&lt;br&gt;绑定 base / head SHA，读取变更文件与 diff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#93C5FD;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="390" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;先召回 Team Memory&lt;/b&gt;&lt;br&gt;同仓库 ACTIVE → Scope 过滤&lt;br&gt;标题 / 描述 / diff 关键词排序 → 默认前 10 条" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#93C5FD;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;模型读代码并做语义判断&lt;/b&gt;&lt;br&gt;diff + read_file / search_text + 已召回规则&lt;br&gt;简单 PR 单 Agent；复杂 PR 可 Main + 专项" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#93C5FD;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="635" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;服务校验与发布前复查&lt;/b&gt;&lt;br&gt;结构、路径、规则 ID / version、分组完整性&lt;br&gt;当前 head、open、非 Draft、仓库 enabled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#93C5FD;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="770" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;发布 COMMENT Review&lt;/b&gt;&lt;br&gt;可定位 → inline finding；否则 → summary&lt;br&gt;记录 finding 与 GitHub 线程绑定" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#93C5FD;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="905" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="&lt;b&gt;用户在 PR 查看问题与建议&lt;/b&gt;&lt;br&gt;可在线程中解释、提出例外或提交修复&lt;br&gt;新 head 会触发新的审查" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#93C5FD;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1050" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;REPLY_HANDLE：记录每条回复&lt;/b&gt;&lt;br&gt;source comment 去重，按 GitHub 时间处理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="390" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;重读当前代码与完整相关线程&lt;/b&gt;&lt;br&gt;原 finding + 本次回复 + 多人讨论&lt;br&gt;同时读取关联规则与召回规则" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="500" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;模型根据代码证据复核&lt;/b&gt;&lt;br&gt;不按人数投票，不按评论者身份定输赢&lt;br&gt;证据不足 → 请求澄清" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="635" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;五类结论&lt;/b&gt;&lt;br&gt;FIXED · MISJUDGMENT · STILL_VALID&lt;br&gt;VALID_EXCEPTION · NEEDS_CLARIFICATION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="770" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;在原线程回复并保存状态&lt;/b&gt;&lt;br&gt;新 head → 重排同一 source comment&lt;br&gt;迟到的旧回复不能回退已发布的新判断" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="905" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;例外 / 规则变化只形成 decision clue&lt;/b&gt;&lt;br&gt;不直接改变 ACTIVE Memory&lt;br&gt;等待 PR 合并后提取及维护者确认" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="1050" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;DECISION_EXTRACT：读取合并快照&lt;/b&gt;&lt;br&gt;最终代码 + PR 讨论 / reviews + 决策线索" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#FCD34D;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="390" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;模型提取可复用的工程决定&lt;/b&gt;&lt;br&gt;要求明确的人类决定 + 代码证据&lt;br&gt;仅有代码写法 / AI 意见 / 未决争议 → 省略" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#FCD34D;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="500" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;服务校验结构与来源&lt;/b&gt;&lt;br&gt;PR、merge SHA、人类 comment ID&lt;br&gt;代码证据所属变更路径" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#FCD34D;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="635" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;保存 CANDIDATE&lt;/b&gt;&lt;br&gt;包含内容、Scope、来源、依据与不确定项&lt;br&gt;不自动生效" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#FCD34D;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="770" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="&lt;b&gt;维护者在管理页决定&lt;/b&gt;&lt;br&gt;OAuth maintain / admin 权限 + CSRF&lt;br&gt;编辑、确认、忽略或替代；保存版本与审计" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#FCD34D;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="905" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="&lt;b&gt;ACTIVE Team Memory&lt;/b&gt;&lt;br&gt;存储在 PostgreSQL&lt;br&gt;供未来 PR 按 Scope 与关键词召回" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFFFF;strokeColor=#FCD34D;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1050" width="400" height="95" as="geometry" />
        </mxCell>
