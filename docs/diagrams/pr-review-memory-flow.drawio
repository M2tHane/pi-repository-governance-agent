        <mxCell id="m-note" value="&lt;b&gt;谁决定规则生效？&lt;/b&gt;&lt;br&gt;有权限的维护者；没有投票或多人会签。&lt;br&gt;普通 PR 评论可在合并提取时作为输入。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#172B4D;spacing=12;fillColor=#FFFBEB;strokeColor=none;fontSize=14;align=left;spacing=0;" vertex="1" parent="1">
